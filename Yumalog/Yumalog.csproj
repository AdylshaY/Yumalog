<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Yumalog</PackageId>
    <Version>1.0.0</Version>
    <Authors>Adylsha Yumayev</Authors>
    <Company>Yumayev Dev</Company>
    <Description>Structured logging library for .NET Framework, worker services, and ASP.NET Core APIs. Supports direct Yumalog usage and Microsoft.Extensions.Logging ILogger integration with JSON file output for Grafana Alloy and Loki pipelines.</Description>
    <PackageTags>logging;ilogger;aspnetcore;serilog;structured-logging;grafana;loki;centralized-logging;enterprise</PackageTags>
    <PackageProjectUrl>https://github.com/AdylshaY/Yumalog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdylshaY/Yumalog</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.0.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
