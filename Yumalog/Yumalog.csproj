<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Yumalog</PackageId>
    <Version>1.0.0</Version>
    <Authors>Adylsha Yumayev</Authors>
    <Company>Yumayev Dev</Company>
    <Description>Centralized structured logging library for .NET Framework and .NET Core applications. Provides JSON-based logging with Grafana Loki integration via Grafana Alloy agent.</Description>
    <PackageTags>logging;serilog;structured-logging;grafana;loki;centralized-logging;enterprise</PackageTags>
    <PackageProjectUrl>https://github.com/AdylshaY/Yumalog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdylshaY/Yumalog</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.0.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
